# .env.example — Meridian Grid Backend
# ======================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control — it is in .gitignore.
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your values
#   uvicorn main:app --reload --port 8000

# ------------------------------------------------------------------
# Security — JWT
# ------------------------------------------------------------------
# Generate a strong key with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_32_CHAR_RANDOM_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ------------------------------------------------------------------
# Database
# ------------------------------------------------------------------
# Path to the SQLite file, relative to backend/.
# Change to an absolute path or a PostgreSQL URL for production.
DB_PATH=meridian.db

# ------------------------------------------------------------------
# Electricity Maps API (auto-poller)
# ------------------------------------------------------------------
# Get your free API key at: https://app.electricitymaps.com/
# Leave empty to disable the poller — the server will still start fine.
ELECTRICITY_MAPS_API_KEY=

# How often to poll (hours). Default: 24 (once per day).
POLL_INTERVAL_HOURS=24

# Electricity Maps zone code for Bangladesh.
POLL_REGION=BD

# ------------------------------------------------------------------
# CORS (browser frontend)
# ------------------------------------------------------------------
# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
