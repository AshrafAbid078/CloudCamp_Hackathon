# .env.example — Meridian Grid Backend
# ======================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control — it is in .gitignore.
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your values
#   uvicorn main:app --reload --port 8000

# ------------------------------------------------------------------
# Security — JWT
# ------------------------------------------------------------------
# Generate a strong key with:  python -c "import secrets; print(secrets.token_hex(32))"
# Local development generates backend/.local-jwt-secret automatically.
# For deployment, set SECRET_KEY to a unique random value of at least 32 characters.
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ------------------------------------------------------------------
# Database
# ------------------------------------------------------------------
# Path to the SQLite file, relative to backend/.
# Change to an absolute path on a persistent volume for deployment.
# This build uses SQLite; DB_PATH does not accept a PostgreSQL URL.
DB_PATH=meridian.db

# Hosted Turso database (Render deployment). Set BOTH values in Render's
# environment settings; leave both empty for local SQLite development.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional hosted-deployment bootstrap password (at least 20 characters).
# Set before the first start, then sign in as admin and change it immediately.
# If omitted, a random credential is written to backend/.initial-admin-credential.
# INITIAL_ADMIN_PASSWORD=

# ------------------------------------------------------------------
# Electricity Maps API (auto-poller)
# ------------------------------------------------------------------
# Create an Electricity Maps account/trial at: https://app.electricitymaps.com/auth/signup
# Leave empty to disable the poller — the server will still start fine.
ELECTRICITY_MAPS_API_KEY=
# Create account: https://app.electricitymaps.com/auth/signup
# After sign-in, find the key: https://app.electricitymaps.com/docs/quickstart/authorization
# An empty key keeps carbon on a clearly labelled archived fallback.

# How often to poll (hours). Default: 24 (once per day).
POLL_INTERVAL_HOURS=24

# Electricity Maps zone code for Bangladesh.
POLL_REGION=BD

# Current regional weather forecast (Open-Meteo, non-commercial demo use).
# Set false to force the archived 2020 forecast. Coordinates are near Dhaka.
LIVE_WEATHER_ENABLED=true
FORECAST_LATITUDE=23.81
FORECAST_LONGITUDE=90.41
LIVE_SOURCE_CACHE_MINUTES=15

# ------------------------------------------------------------------
# CORS (browser frontend)
# ------------------------------------------------------------------
# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
